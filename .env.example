# Copy this file to .env and fill in real values. Never commit .env.

# n8n (self-hosted, public HTTPS)
N8N_BASE_URL=https://your-n8n-domain.com
N8N_WEBHOOK_SECRET=a-long-random-string-shared-with-the-dashboard
# n8n API key (Settings > n8n API). Lets scripts create and update workflows.
N8N_API_KEY=

# AI extraction. AI_PROVIDER picks which one is used: openai or anthropic.
AI_PROVIDER=openai

# OpenAI (current provider)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# Anthropic (optional, for comparing providers later)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=invoices

# Slack
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_APPROVALS_CHANNEL_ID=
SLACK_ALERTS_CHANNEL_ID=

# Xero (demo company only)
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_TENANT_ID=

# Gmail intake
GMAIL_INTAKE_ADDRESS=
GMAIL_INTAKE_LABEL=invoices

# Public demo limits
DEMO_UPLOADS_PER_IP_PER_DAY=5
DEMO_MAX_FILE_MB=5
DEMO_MAX_PAGES=10
DEMO_DAILY_UPLOAD_CAP=100
DEMO_UPLOAD_RETENTION_HOURS=24
