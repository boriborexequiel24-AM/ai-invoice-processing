{
  "name": "Invoice Processing | 4. Email intake",
  "nodes": [
    {
      "id": "3fba57c4-05e0-553d-ab8c-41cafbffc1d1",
      "name": "Every minute",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        300
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 1
            }
          ]
        }
      }
    },
    {
      "id": "95904180-25dc-5042-993d-6d6c43b6785e",
      "name": "Config",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        230,
        300
      ],
      "parameters": {
        "jsCode": "// Generated by scripts/build_n8n_workflow.py.\nreturn [{ json: {\n  \"intake_url\": \"https://YOUR-N8N-DOMAIN/webhook/invoice-intake\",\n  \"webhook_secret\": \"YOUR-N8N-WEBHOOK-SECRET\",\n  \"alerts_channel\": \"YOUR-ALERTS-CHANNEL-ID\",\n  \"label_name\": \"invoice-demo\"\n} }];"
      }
    },
    {
      "id": "bfdc082b-12b8-5a7c-94b6-6ab517662667",
      "name": "Get labels",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        460,
        300
      ],
      "parameters": {
        "method": "GET",
        "url": "https://gmail.googleapis.com/gmail/v1/users/me/labels",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "gmailOAuth2",
        "options": {
          "timeout": 30000
        }
      }
    },
    {
      "id": "f1c56fa6-872f-56ca-a4a0-87d361398925",
      "name": "Find label",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        690,
        300
      ],
      "parameters": {
        "jsCode": "// Gmail needs a label id, not a name, to take a label off a message.\nconst wanted = $('Config').first().json.label_name.toLowerCase();\nconst labels = $input.first().json.labels || [];\nconst match = labels.find(l => String(l.name).toLowerCase() === wanted);\nif (!match) {\n  throw new Error(`No Gmail label named \"${$('Config').first().json.label_name}\". Create it, then label an invoice.`);\n}\nreturn [{ json: { label_id: match.id } }];"
      }
    },
    {
      "id": "701486a1-c6d5-50da-8541-c77aeddd7a0f",
      "name": "Get labelled mail",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        920,
        300
      ],
      "parameters": {
        "resource": "message",
        "operation": "getAll",
        "returnAll": false,
        "limit": 10,
        "simple": false,
        "filters": {
          "q": "label:invoice-demo has:attachment"
        },
        "options": {
          "downloadAttachments": true
        }
      },
      "alwaysOutputData": true
    },
    {
      "id": "342ebc69-5e7a-530a-a1cc-ae00750ea172",
      "name": "Pick PDF attachments",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1150,
        300
      ],
      "parameters": {
        "jsCode": "// One item per PDF attachment, with the file always under the same name,\n// so the next step can post it without knowing how many came in.\nconst out = [];\n\nfor (const item of $input.all()) {\n  const message = item.json;\n\n  // Gmail returns the sender and subject in a few shapes depending on the\n  // node version, so read the raw headers first and fall back from there.\n  const headers = {};\n  for (const h of message.payload?.headers || []) headers[String(h.name).toLowerCase()] = h.value;\n  const from = headers.from ?? message.From ?? message.from?.value?.[0]?.address ?? message.from ?? null;\n  const subject = headers.subject ?? message.Subject ?? message.subject ?? null;\n\n  for (const [key, meta] of Object.entries(item.binary || {})) {\n    const fileName = meta.fileName || '';\n    const isPdf = meta.mimeType === 'application/pdf' || fileName.toLowerCase().endsWith('.pdf');\n    if (!isPdf) continue;\n    out.push({\n      json: {\n        file_name: fileName || 'invoice.pdf',\n        message_id: message.id,\n        subject: typeof subject === 'string' ? subject.slice(0, 200) : null,\n        from: typeof from === 'string' ? from.slice(0, 200) : null,\n      },\n      binary: { file: item.binary[key] },\n    });\n  }\n}\n\nreturn out;  // nothing labelled means no items, and the run stops here"
      }
    },
    {
      "id": "b3ca73f1-7517-5ccb-8cd8-31055b7e74a6",
      "name": "Send to intake",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1380,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').first().json.intake_url }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-webhook-secret",
              "value": "={{ $('Config').first().json.webhook_secret }}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "multipart-form-data",
        "bodyParameters": {
          "parameters": [
            {
              "name": "source",
              "value": "email"
            },
            {
              "parameterType": "formBinaryData",
              "name": "file",
              "inputDataFieldName": "file"
            }
          ]
        },
        "options": {
          "timeout": 180000,
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          }
        }
      },
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 5000,
      "alwaysOutputData": true
    },
    {
      "id": "b1126df8-6154-55f4-88df-bfb7802970d8",
      "name": "Summarize",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1610,
        300
      ],
      "parameters": {
        "jsCode": "// Keep a readable line per attachment, and carry the message id through so\n// the label can be taken off the ones that made it.\nconst sent = $('Pick PDF attachments').all();\nreturn $input.all().map((item, i) => {\n  const status = item.json.statusCode;\n  const body = item.json.body ?? {};\n  return {\n    json: {\n      file_name: sent[i]?.json.file_name,\n      message_id: sent[i]?.json.message_id,\n      from: sent[i]?.json.from,\n      status,\n      outcome: status === 200 ? body.status : status === 409 ? 'already processed' : 'failed',\n      invoice_id: body.invoice_id ?? null,\n    },\n  };\n});"
      }
    },
    {
      "id": "02fd2b70-618e-5ff5-a988-543c4740f1b0",
      "name": "Accepted?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1840,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "b85e2e24-6030-5f93-9c97-44fa11c04028",
              "leftValue": "={{ [200, 409].includes($json.status) }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "0c4a509b-7fcc-539a-ab32-c0033476ea04",
      "name": "Take label off",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2070,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "=https://gmail.googleapis.com/gmail/v1/users/me/messages/{{ $json.message_id }}/modify",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "gmailOAuth2",
        "options": {
          "timeout": 30000
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ removeLabelIds: [$('Find label').first().json.label_id] }) }}"
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "a76bd3fa-3f72-50fc-8c91-d2cd44d97610",
      "name": "Alert team",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2070,
        480
      ],
      "parameters": {
        "method": "POST",
        "url": "https://slack.com/api/chat.postMessage",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "slackApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ channel: $('Config').first().json.alerts_channel, text: ':warning: An emailed invoice could not be processed: ' + $json.file_name + ' from ' + ($json.from || 'unknown sender') + ' (status ' + $json.status + ')' + '. It keeps its label and will be retried.' }) }}",
        "options": {}
      },
      "onError": "continueRegularOutput"
    }
  ],
  "connections": {
    "Every minute": {
      "main": [
        [
          {
            "node": "Config",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Config": {
      "main": [
        [
          {
            "node": "Get labels",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get labels": {
      "main": [
        [
          {
            "node": "Find label",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Find label": {
      "main": [
        [
          {
            "node": "Get labelled mail",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get labelled mail": {
      "main": [
        [
          {
            "node": "Pick PDF attachments",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Pick PDF attachments": {
      "main": [
        [
          {
            "node": "Send to intake",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send to intake": {
      "main": [
        [
          {
            "node": "Summarize",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Summarize": {
      "main": [
        [
          {
            "node": "Accepted?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Accepted?": {
      "main": [
        [
          {
            "node": "Take label off",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Alert team",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveDataSuccessExecution": "none",
    "saveDataErrorExecution": "all"
  }
}
