{
  "name": "Invoice Processing | 3. Cleanup expired uploads",
  "nodes": [
    {
      "id": "a8640ca8-2c84-54ff-8da4-bf284da5ced9",
      "name": "Every hour",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        300
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 1
            }
          ]
        }
      }
    },
    {
      "id": "95904180-25dc-5042-993d-6d6c43b6785e",
      "name": "Config",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        300
      ],
      "parameters": {
        "jsCode": "// Generated by scripts/build_n8n_workflow.py.\nreturn [{ json: {\n  \"supabase_url\": \"https://YOUR-PROJECT.supabase.co\",\n  \"bucket\": \"invoices\"\n} }];"
      }
    },
    {
      "id": "11318e09-7c27-5b61-9aa6-857f2618e8c4",
      "name": "Find expired uploads",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        480,
        300
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ $('Config').first().json.supabase_url }}/rest/v1/invoices?select=id,file_path,slack_channel,slack_message_ts&expires_at=lt.{{ new Date().toISOString() }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendHeaders": false,
        "headerParameters": {
          "parameters": []
        },
        "options": {}
      }
    },
    {
      "id": "8963f91c-30b6-5620-b7a8-21924a901d4a",
      "name": "Delete Slack message",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        720,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "https://slack.com/api/chat.delete",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "slackApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ channel: $json.slack_channel, ts: $json.slack_message_ts }) }}",
        "options": {}
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "4ea0ea5a-4af1-5e15-a90f-4695763df79d",
      "name": "Delete PDFs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        960,
        300
      ],
      "parameters": {
        "method": "DELETE",
        "url": "={{ $('Config').first().json.supabase_url }}/storage/v1/object/{{ $('Config').first().json.bucket }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendHeaders": false,
        "headerParameters": {
          "parameters": []
        },
        "options": {},
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ prefixes: $('Find expired uploads').all().map(i => i.json.file_path).filter(Boolean) }) }}"
      },
      "executeOnce": true,
      "alwaysOutputData": true,
      "onError": "continueRegularOutput"
    },
    {
      "id": "58c5fc64-a8a1-5f05-9fe6-f5a279738886",
      "name": "Delete invoices",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1200,
        300
      ],
      "parameters": {
        "method": "DELETE",
        "url": "={{ $('Config').first().json.supabase_url }}/rest/v1/invoices?id=in.({{ $('Find expired uploads').all().map(i => i.json.id).join(',') }})",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Prefer",
              "value": "return=minimal"
            }
          ]
        },
        "options": {}
      },
      "executeOnce": true,
      "alwaysOutputData": true
    }
  ],
  "connections": {
    "Every hour": {
      "main": [
        [
          {
            "node": "Config",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Config": {
      "main": [
        [
          {
            "node": "Find expired uploads",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Find expired uploads": {
      "main": [
        [
          {
            "node": "Delete Slack message",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Delete Slack message": {
      "main": [
        [
          {
            "node": "Delete PDFs",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Delete PDFs": {
      "main": [
        [
          {
            "node": "Delete invoices",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
